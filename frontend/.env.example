# Copy this file to .env and fill in your values.
#
# Your PC's IP address (where the backend runs), or "auto" to detect it automatically.
# Find it with `ipconfig` (Wi-Fi IPv4 Address) or from the backend's startup log.
# After editing, restart Expo with:  npx expo start -c
EXPO_PUBLIC_API_IP=auto
EXPO_PUBLIC_API_PORT=5000

# After deploying the backend online, set the full URL instead (overrides the IP):
# EXPO_PUBLIC_API_URL=https://your-backend.onrender.com/api
